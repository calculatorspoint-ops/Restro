# Branding Configuration (Parent Company & Product Application)
VITE_COMPANY_NAME=MK Innovexa
VITE_APP_NAME=RestoSetup ERP

# Firebase Configuration for Production Deployment (e.g. Vercel, Railway, Docker, Cloud Run)
# Copy this file to .env.local and fill in your own values from the Firebase Console.
# NEVER commit .env.local or real credentials to version control.
# Set these values directly in your Vercel project's Environment Variables dashboard.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Firestore Database ID:
# - Leave blank or omit to use the default Firestore database (standard Firebase Console projects).
# - Set to your named database ID if you are using a non-default Firestore database.
VITE_FIREBASE_DATABASE_ID=
